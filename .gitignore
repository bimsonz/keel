node_modules/
dist/
coverage/
*.log
.DS_Store

# Generated by `pnpm gen`; never committed (packages/contracts/openapi.json is the one exception)
*.gen.ts
src/generated/
worker-configuration.d.ts
packages/syntax/src/generated/
packages/testing/src/generated/
packages/spec/tsp-output/

# Seeded credentials and run transcripts (scripts/seed.ts, e2e): never committed.
# At any depth. Only the repository's own flow and the worker-lite fixture's deploy file are.
**/.keel/*
!/.keel/flow.json
!/fixtures/worker-lite/.keel/deploy.json

# Wrangler
.wrangler/
.dev.vars*
wrangler.deploy.jsonc

# Terraform: state lives in the remote backend, never in git
infra/**/.terraform/
infra/**/.terraform.lock.hcl.bak
*.tfstate
*.tfstate.*
*.tfplan
infra/**/backups/
infra/**/.terraform.tfstate.lock.info

# Control fixtures mirror the real layout, generated paths included, and must be committed.
!test/controls/**/src/generated/
!test/controls/**/*.gen.ts
