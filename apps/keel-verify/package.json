{
  "name": "@keeltown/keel-verify",
  "version": "0.0.0",
  "private": true,
  "description": "The untrusted execution plane: holds no credentials",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "gen": "wrangler types --include-runtime=true --strict-vars=false",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p test/live/tsconfig.json",
    "deploy:dry": "wrangler deploy --dry-run --outdir .wrangler/dry-run"
  },
  "dependencies": {
    "@cloudflare/ci": "catalog:",
    "@cloudflare/sandbox": "catalog:",
    "@cloudflare/worker-bundler": "catalog:",
    "@keeltown/core": "workspace:*",
    "@keeltown/runner-protocol": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "catalog:",
    "@keeltown/testing": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
