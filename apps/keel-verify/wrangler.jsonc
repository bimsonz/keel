{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "keel-verify",
  "main": "src/index.ts",
  // One compatibility date across every Worker in the repo (rule R13).
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // keel-verify holds no credentials: nothing it runs can reach anything worth stealing.
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true },
  "vars": {
    "KEEL_HOST": "keel-verify.localhost",
    "BACKUP_BUCKET_NAME": "keel-staging-sandbox-backups",
    // Container classes under the durable_object scheduling policy, which BoxGate counts (rule R13).
    "BOXGATE_CLASSES": "",
    // The public half (SPKI) of the key pair keel signs bundle URLs with: the bundle host verifies with it.
    // scripts/deploy.ts fills it from Terraform. It signs nothing, so keel-verify still holds no secret.
    "BUNDLE_URL_PUBLIC_KEY": "",
  },
  "durable_objects": {
    "bindings": [
      { "name": "VERIFIER", "class_name": "VerifierDO" },
      { "name": "SANDBOX", "class_name": "KeelSandbox" },
      // One deps box per (namespace, install digest): it installs a candidate's dependencies and keeps them as parts.
      { "name": "DEPSBOX", "class_name": "KeelDepsBox" },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["VerifierDO", "KeelSandbox"] },
    { "tag": "v2", "new_sqlite_classes": ["KeelDepsBox"] },
  ],
  // Tier 2 (ExecBox): a classic Sandbox container, so its instances are capped here; the account is shared.
  // Four vCPUs, as CI's runner has: Keel's own suite takes 20 minutes on one, its step's whole timeout.
  "containers": [
    {
      "class_name": "KeelSandbox",
      "image": "./containers/sandbox/Dockerfile",
      "instance_type": "standard-4",
      "max_instances": 10,
    },
    // The deps box: the same image, with the registry reachable through its own outbound handler.
    {
      "class_name": "KeelDepsBox",
      "image": "./containers/sandbox/Dockerfile",
      "instance_type": "standard-4",
      "max_instances": 4,
    },
  ],
  "r2_buckets": [
    { "binding": "BACKUP_BUCKET", "bucket_name": "keel-staging-sandbox-backups" },
    // Candidate bundles, which keel writes. keel-verify reads them, and writes only a deps build's
    // parts and pointer, from the deps box alone (guard: readonly-bundles).
    { "binding": "BUNDLES", "bucket_name": "keel-staging-bundles" },
  ],
  // Tier 1: throwaway isolates for probes, pure checks and Wasm tools.
  "worker_loaders": [{ "binding": "LOADER" }],
}
