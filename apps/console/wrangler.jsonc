{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "keel-console",
  "main": "src/worker/index.ts",
  // One compatibility date across every Worker in the repo (rule R13).
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // Never commit account_id: deploys read CLOUDFLARE_ACCOUNT_ID at runtime (rule R13).
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true },
  // The built page (`vite build`). Every place in the console is a path under a project, so a path
  // that is not a file is the page, one with a dot in it included (/keel/blob/trunk/src/index.ts).
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Only these reach the Worker's code: its health check, the three git paths of a clone
    // address, Keel's own paths, and the paths nothing here answers, which it answers 404 (the
    // first segments Keel reserves that have no page, file or Worker here, and /sitemap.xml). A
    // `*` here matches across segments, so the Worker checks the path's shape itself. Everything
    // else is a file or the page.
    "run_worker_first": [
      "/healthz",
      "/*.git/info/refs",
      "/*.git/git-upload-pack",
      "/*.git/git-receive-pack",
      "/v1/*",
      "/mcp",
      "/mcp/*",
      "/start",
      "/llms.txt",
      "/.well-known/*",
      "/api",
      "/api/*",
      "/auth",
      "/auth/*",
      "/logout",
      "/logout/*",
      "/install",
      "/install/*",
      "/admin",
      "/admin/*",
      "/favicon.ico",
      "/sitemap.xml",
      // A project's pages, for the card a crawler reads (src/worker/cards.ts); the build's own files
      // are under /assets and stay the assets' alone.
      "/*/*",
      "!/assets/*",
    ],
  },
  // Keel's Worker. A clone address (/<namespace>/<project>.git) is a path no route can name, and
  // Keel's own paths have no route at all on a site with no zone (a workers.dev address), so this
  // Worker hands those requests on as they came, and adds nothing to them.
  "services": [{ "binding": "KEEL", "service": "keel" }],
  // No secret: the page reads Keel itself, on this host under /v1, as whoever is signed in.
  // scripts/guard-build.ts fails the build if this file names a credential again.
  "vars": {
    // The public host this Worker answers on. scripts/deploy.ts overrides it per environment.
    "KEEL_HOST": "keel-console.localhost",
  },
}
