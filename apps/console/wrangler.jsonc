{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "keel-console",
  "main": "src/worker/index.ts",
  // One compatibility date across every Worker in the repo (rule R13).
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // Never commit account_id: deploys read CLOUDFLARE_ACCOUNT_ID at runtime (rule R13).
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true },
  // The built page (`vite build`). Every place in the console is a path under a project, so a path
  // that is not a file is the page, one with a dot in it included (/keel/blob/trunk/src/index.ts).
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Only these reach the Worker's code: its health check, and the three git paths of a clone
    // address. A `*` here matches across segments, so the Worker checks the path's shape itself.
    // Everything else is a file or the page.
    "run_worker_first": [
      "/healthz",
      "/*.git/info/refs",
      "/*.git/git-upload-pack",
      "/*.git/git-receive-pack",
    ],
  },
  // Keel's Worker, for a clone address alone (/<namespace>/<project>.git): no route can name that
  // path, so this Worker hands a git client's request on as it came, and adds nothing to it.
  "services": [{ "binding": "KEEL", "service": "keel" }],
  // No secret: the page reads Keel itself, on this host under /v1, as whoever is signed in.
  // scripts/guard-build.ts fails the build if this file names a credential again.
  "vars": {
    // The public host this Worker answers on. scripts/deploy.ts overrides it per environment.
    "KEEL_HOST": "keel-console.localhost",
  },
}
