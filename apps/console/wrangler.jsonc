{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "keel-console",
  "main": "src/worker/index.ts",
  // One compatibility date across every Worker in the repo (rule R13).
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // Never commit account_id: deploys read CLOUDFLARE_ACCOUNT_ID at runtime (rule R13).
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true },
  // The built page (`vite build`). Every place in the console is a path under a project, so a path
  // that is not a file is the page, one with a dot in it included (/keel/blob/trunk/src/index.ts).
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Only this reaches the Worker's code. Everything else is a file or the page.
    "run_worker_first": ["/healthz"],
  },
  // No binding to Keel and no secret: the page reads Keel itself, on this host under /v1, as whoever is
  // signed in. scripts/guard-build.ts fails the build if this file names a credential again.
  "vars": {
    // The public host this Worker answers on. scripts/deploy.ts overrides it per environment.
    "KEEL_HOST": "keel-console.localhost",
  },
}
