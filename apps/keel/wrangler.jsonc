{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "keel",
  "main": "src/index.ts",
  // One compatibility date across every Worker in the repo (rule R13).
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // Never commit account_id: deploys read CLOUDFLARE_ACCOUNT_ID at runtime (rule R13).
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true },
  "vars": {
    // The public host this Worker answers on. scripts/deploy.ts overrides it per environment.
    "KEEL_HOST": "keel.localhost",
    // staging | production | test. Tests rethrow contract drift instead of answering 500.
    "KEEL_ENV": "staging",
    "BACKUP_BUCKET_NAME": "keel-staging-sandbox-backups",
    // Container classes under the durable_object scheduling policy, which BoxGate counts (rule R13).
    "BOXGATE_CLASSES": "",
    // The region of this deployment's Artifacts namespaces. Repo-touching DOs are placed near it.
    "ARTIFACTS_LOCATION_HINT": "wnam",
    // How many ready workspaces a new project's pool keeps forked ahead of declares.
    "POOL_TARGET": "4",
    // Every key Keel signs or has signed commits with, as JSON: [{ publicKey, validAfter?, validBefore? }],
    // each key as `ssh-ed25519 <base64>` and each time ISO 8601. Served as the allowed-signers file at
    // /.well-known/keel/allowed-signers. scripts/deploy.ts fills it from Terraform; a compose is a defect
    // while it does not hold KEEL_COMMIT_SIGNING_KEY's public half for the commit's time.
    "KEEL_COMMIT_SIGNERS": "[]",
    // Each PlatformFunction's model, by exact id: never cloudflare/auto.
    "PLATFORM_FUNCTION_PINS": { "keel.probe.freshness": "@cf/moonshotai/kimi-k2.7-code" },
  },
  "secrets": {
    // KEEL_SIGNING_KEY: an Ed25519 private key, as a JWK, that signs agents' bearer tokens.
    // CLOUDFLARE_ACCOUNT_ID: read by @cloudflare/ci; a secret so it is never committed.
    // @cloudflare/ci's CF_TOKEN and R2 S3 keys are deliberately absent: backups go through
    // the BACKUP_BUCKET binding and no runner asks for credentials (guard: runner-credentials).
    // BETTER_AUTH_SECRET: signs and encrypts Better Auth's cookies and tokens. From Terraform.
    // BUNDLE_URL_SIGNING_KEY: the Ed25519 private key (PKCS#8) that signs each bundle URL a sandbox is
    // handed; keel-verify's bundle host verifies with the public half and holds no secret. From Terraform.
    // KEEL_COMMIT_SIGNING_KEY: the Ed25519 private key (PKCS#8) that signs every commit Keel composes, apart
    // from every other key; its public half is in KEEL_COMMIT_SIGNERS. From Terraform.
    // GITHUB_CLIENT_ID/GITHUB_CLIENT_SECRET are optional: GitHub sign-in is offered only when both are set.
    "required": [
      "KEEL_SIGNING_KEY",
      "CLOUDFLARE_ACCOUNT_ID",
      "BETTER_AUTH_SECRET",
      "BUNDLE_URL_SIGNING_KEY",
      "KEEL_COMMIT_SIGNING_KEY",
    ],
  },
  // Workers Rate Limiting, each keyed by IP: writes to /v1/auth/* (sign-in, codes, sign-up),
  // and token exchanges at /v1/oauth/token.
  "ratelimits": [
    { "name": "AUTH_LIMIT", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } },
    { "name": "TOKEN_LIMIT", "namespace_id": "1002", "simple": { "limit": 60, "period": 60 } },
  ],

  // Every id below is a sentinel. scripts/deploy.ts writes a gitignored
  // wrangler.deploy.jsonc with the real ids from Terraform, and refuses to
  // deploy while any sentinel remains, so wrangler never provisions behind
  // Terraform's back.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "keel-staging",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  "durable_objects": {
    "bindings": [
      { "name": "AGENT_SESSION", "class_name": "AgentSessionDO" },
      { "name": "CHANGE", "class_name": "ChangeDO" },
      { "name": "SUBJECT", "class_name": "SubjectDO" },
      { "name": "LANE", "class_name": "LaneDO" },
      { "name": "TRUNK", "class_name": "TrunkDO" },
      { "name": "PROJECT", "class_name": "ProjectDO" },
      { "name": "WORKSPACE_POOL", "class_name": "WorkspacePoolDO" },
      { "name": "PROJECTOR", "class_name": "ProjectorDO" },
      { "name": "ORG_USAGE", "class_name": "OrgUsageDO" },
      { "name": "NAMESPACE", "class_name": "NamespaceDO" },
      { "name": "MERGEBOX", "class_name": "MergeBox" },
      { "name": "BOXGATE", "class_name": "BoxGate" },
      // Tier 2 runners live in keel-verify, which holds no credentials.
      { "name": "SANDBOX", "class_name": "KeelSandbox", "script_name": "keel-verify" },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "AgentSessionDO",
        "ChangeDO",
        "SubjectDO",
        "LaneDO",
        "TrunkDO",
        "ProjectDO",
        "WorkspacePoolDO",
        "ProjectorDO",
        "MergeBox",
        "BoxGate",
      ],
    },
    { "tag": "v2", "new_sqlite_classes": ["OrgUsageDO"] },
    { "tag": "v3", "new_sqlite_classes": ["NamespaceDO"] },
  ],
  "workflows": [
    { "name": "keel-precheck", "binding": "PRECHECK", "class_name": "Precheck" },
    { "name": "keel-probe", "binding": "PROBE", "class_name": "Probe" },
    { "name": "keel-world-check", "binding": "WORLD_CHECK", "class_name": "KeelWorldCheck" },
    // KeelVerify extends @cloudflare/ci's CIWorkflow, which expects this binding name.
    { "name": "keel-verify-batch", "binding": "CI_WORKFLOW", "class_name": "KeelVerify" },
    { "name": "keel-push-observed", "binding": "PUSH_OBSERVED", "class_name": "PushObserved" },
  ],
  "triggers": {
    // Enforces the privacy notice's retention deadlines (composition/retention.ts).
    "crons": ["*/10 * * * *"],
    // One namespace-wide rule per shard (S6); per-repo subscriptions dropped pushes.
    "events": [
      {
        "type": "cf.artifacts.repo.pushed",
        "filter": { "namespace": "keel-ws-00" },
        "targets": [{ "type": "workflow", "workflow_name": "keel-push-observed" }],
      },
    ],
  },
  "queues": {
    "producers": [{ "binding": "JOBS", "queue": "keel-staging-jobs" }],
    "consumers": [{ "queue": "keel-staging-jobs", "max_retries": 5 }],
  },
  "r2_buckets": [
    { "binding": "BUNDLES", "bucket_name": "keel-staging-bundles" },
    { "binding": "ARCHIVE", "bucket_name": "keel-staging-archive" },
    { "binding": "BACKUP_BUCKET", "bucket_name": "keel-staging-sandbox-backups" },
  ],
  "artifacts": [
    // ARTIFACTS is the core namespace (trunk, staging, guards); @cloudflare/ci expects this name.
    { "binding": "ARTIFACTS", "namespace": "keel-core" },
    { "binding": "WORKSPACES", "namespace": "keel-ws-00" },
  ],
  "secrets_store_secrets": [
    {
      "binding": "DEPLOY_TOKEN",
      "store_id": "PLACEHOLDER-secrets-store",
      "secret_name": "keel-staging-deploy-token",
    },
  ],
  "ai": { "binding": "AI" },
  // RPC into keel-verify, for Tier 1 probes, pure checks and Wasm tools.
  "services": [{ "binding": "VERIFIER", "service": "keel-verify" }],
}
