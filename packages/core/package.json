{
  "name": "@keeltown/core",
  "version": "0.0.0",
  "private": true,
  "description": "The hexagon: pure domain and Effect use-cases behind ports",
  "license": "MIT",
  "type": "module",
  "exports": {
    "./kernel": "./src/domain/kernel/index.ts",
    "./domain/*": "./src/domain/*/index.ts",
    "./application/*": "./src/application/*/index.ts",
    "./ports": "./src/application/ports/index.ts",
    "./not-implemented": "./src/application/not-implemented.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p test/tsconfig.json"
  },
  "dependencies": {
    "effect": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "fast-check": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
