+  removeCollaborator(repoId: string, userId: string, removedBy: string, at: number): void {
+    const collaborators = this.#bucket(this.#collaborators, repoId);
+    const removed = this.#require(collaborators, userId, "collaborator");
+    collaborators.delete(userId);
+    this.events.emit({ type: "collaborator.removed", at, repoId, userId, role: removed.role, removedBy });
+  }
