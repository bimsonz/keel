index 0000000..1c37caa
--- /dev/null
+++ b/test/revoke-collaborator.test.ts
@@ -0,0 +1,74 @@
+import { describe, expect, it } from "vitest";
+import type { CollaboratorRole } from "../src/domain/roles.ts";
+import type { CollaboratorView } from "../src/http/views.ts";
+import { START, harness, json, problem } from "./support/harness.ts";
+
+/** Alice owns alice/forge with Bob as a collaborator. Bob is signed in. */
+async function forgeWithBob(role: CollaboratorRole = "admin", visibility: "public" | "private" = "public") {
+  const h = harness();
+  const alice = await h.user("alice");
+  const bob = await h.user("bob");
+  await h.createRepo(alice, "forge", visibility);
+  await h.addCollaborator(alice, "forge", "bob", role);
+  return { h, alice, bob };
+}
+
+describe("revoking a collaborator", () => {
+  it("removes them from the collaborator list", async () => {
+    const { alice } = await forgeWithBob("write");
+    expect((await alice.delete("/repos/alice/forge/collaborators/bob")).status).toBe(204);
+    expect(await json<CollaboratorView[]>(await alice.get("/repos/alice/forge/collaborators"))).toEqual([]);
+  });
+
+  it("stops a revoked admin from deleting the repository", async () => {
+    const { alice, bob } = await forgeWithBob("admin");
+    expect((await alice.delete("/repos/alice/forge/collaborators/bob")).status).toBe(204);
+    expect((await problem(await bob.delete("/repos/alice/forge"), 403)).detail).toBe(
+      "delete-repo on alice/forge requires the admin role",
+    );
+    expect((await alice.get("/repos/alice/forge")).status).toBe(200);
+  });
+
+  it("hides a private repository from the revoked collaborator", async () => {
+    const { alice, bob } = await forgeWithBob("read", "private");
+    expect((await alice.delete("/repos/alice/forge/collaborators/bob")).status).toBe(204);
+    await problem(await bob.get("/repos/alice/forge"), 404);
+  });
+
+  it("emits collaborator.removed with the role taken away and the acting user", async () => {
+    const { h, alice } = await forgeWithBob("maintain");
+    h.clock.advance(5_000);
+    await alice.delete("/repos/alice/forge/collaborators/bob");
+    expect(h.events.at(-1)).toEqual({
+      type: "collaborator.removed",
+      at: START + 5_000,
+      repoId: "repo_1",
+      userId: "usr_2",
+      role: "maintain",
+      removedBy: "usr_1",
+    });
+  });
+
+  it("answers 404 for someone who is not a collaborator", async () => {
+    const { h, alice } = await forgeWithBob();
+    await h.signUp("carol");
+    const res = await alice.delete("/repos/alice/forge/collaborators/carol");
+    expect((await problem(res, 404)).detail).toBe("carol is not a collaborator on this repository");
+  });
+
+  it("is reserved for admins and the owner", async () => {
+    const { h, alice } = await forgeWithBob();
+    const carol = await h.user("carol");
+    await h.addCollaborator(alice, "forge", "carol", "maintain");
+    const res = await carol.delete("/repos/alice/forge/collaborators/bob");
+    expect((await problem(res, 403)).detail).toBe("remove-collaborator on alice/forge requires the admin role");
+  });
+
+  it("lets the owner add a revoked collaborator back with a lower role", async () => {
+    const { h, alice, bob } = await forgeWithBob("admin");
+    await alice.delete("/repos/alice/forge/collaborators/bob");
+    await h.addCollaborator(alice, "forge", "bob", "read");
+    expect((await bob.get("/repos/alice/forge")).status).toBe(200);
+    await problem(await bob.delete("/repos/alice/forge"), 403);
+  });
+});
