+function callerRole(c: Context<AppEnv>, repo: RepoRecord, action: Action): Role | null {
+  const { session } = c.var;
+  if (session === undefined) return null;
+  if (repo.ownerId === session.userId) return "owner";
+
+  const { store } = c.var.deps;
+  const cache = roleCacheFor(store);
+  const cached = cache.get(session.id, repo.id);
+  // Enough is enough. A cached role that falls short is looked up again, in
+  // case the caller has been promoted since it was cached.
+  if (cached !== undefined && allows(cached, action, repo.visibility)) return cached;
+
+  const role = evaluateRole(store, repo, session.userId);
+  if (role !== null && role !== "owner") cache.set(session.id, repo.id, role);
+  return role;
