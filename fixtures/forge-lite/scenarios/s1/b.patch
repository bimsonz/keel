+import type { CollaboratorRole } from "../domain/roles.ts";
+import type { Store } from "../store/types.ts";
+
+/**
+ * Per-session cache of evaluated collaborator roles, keyed by (session,
+ * repository). Evaluating a role costs a collaborator lookup in the store,
+ * and a session tends to make many requests against the same repository, so
+ * only the first of them pays for the lookup.
+ *
+ * Nothing here needs invalidating, because collaborator roles only ever go
+ * up: a collaborator can be added or promoted, never demoted or removed. A
+ * cached role may lag behind a promotion but never exceeds what the caller
+ * holds, so requirePermission trusts a cached role when it is enough for the
+ * action and looks the caller up again when it falls short.
+ */
+export class RoleCache {
+  readonly #roles = new Map<string, CollaboratorRole>();
+
+  get(sessionId: string, repoId: string): CollaboratorRole | undefined {
+    return this.#roles.get(key(sessionId, repoId));
+  }
+
+  set(sessionId: string, repoId: string, role: CollaboratorRole): void {
+    this.#roles.set(key(sessionId, repoId), role);
+  }
+}
+
+const caches = new WeakMap<Store, RoleCache>();
+
+/** The role cache for `store`. Each store, and so each app, gets its own. */
+export function roleCacheFor(store: Store): RoleCache {
+  let cache = caches.get(store);
+  if (cache === undefined) {
+    cache = new RoleCache();
+    caches.set(store, cache);
+  }
+  return cache;
+}
+
+function key(sessionId: string, repoId: string): string {
+  return `${sessionId}:${repoId}`;
+}
