diff --git a/test/permission-cache.test.ts b/test/permission-cache.test.ts
new file mode 100644
index 0000000..eb76127
--- /dev/null
+++ b/test/permission-cache.test.ts
@@ -0,0 +1,113 @@
+import { describe, expect, it } from "vitest";
+import { MemoryStore } from "../src/store/memory.ts";
+import type { CollaboratorRecord } from "../src/store/types.ts";
+import { harness, problem } from "./support/harness.ts";
+
+/** Counts collaborator lookups, which is the work the role cache saves. */
+class CountingStore extends MemoryStore {
+  lookups = 0;
+
+  override getCollaborator(repoId: string, userId: string): CollaboratorRecord | undefined {
+    this.lookups += 1;
+    return super.getCollaborator(repoId, userId);
+  }
+}
+
+const SHA = "d".repeat(40);
+
+/** Alice owns the private alice/forge; Bob writes to it. */
+async function forge() {
+  const store = new CountingStore();
+  const h = harness({ store });
+  const alice = await h.user("alice");
+  const bob = await h.user("bob");
+  await h.createRepo(alice, "forge", "private");
+  await h.addCollaborator(alice, "forge", "bob", "write");
+  return { h, store, alice, bob };
+}
+
+/** How many collaborator lookups `work` caused. */
+async function lookupsDuring(store: CountingStore, work: () => Promise<void>): Promise<number> {
+  const before = store.lookups;
+  await work();
+  return store.lookups - before;
+}
+
+describe("permission cache", () => {
+  it("looks a session's role up on its first request to a repository", async () => {
+    const { store, bob } = await forge();
+    let status = 0;
+    const lookups = await lookupsDuring(store, async () => {
+      status = (await bob.get("/repos/alice/forge")).status;
+    });
+    expect(status).toBe(200);
+    expect(lookups).toBe(1);
+  });
+
+  it("answers the same session's later requests from the cache", async () => {
+    const { store, bob } = await forge();
+    await bob.get("/repos/alice/forge");
+    const statuses: number[] = [];
+    const lookups = await lookupsDuring(store, async () => {
+      statuses.push((await bob.get("/repos/alice/forge")).status);
+      statuses.push((await bob.put("/repos/alice/forge/refs/heads/main", { sha: SHA })).status);
+      statuses.push((await bob.get("/repos/alice/forge/refs")).status);
+    });
+    expect(statuses).toEqual([200, 201, 200]);
+    expect(lookups).toBe(0);
+  });
+
+  it("starts every new session cold", async () => {
+    const { h, store, bob } = await forge();
+    await bob.get("/repos/alice/forge");
+    const phone = h.client(await h.login("bob"), "bob");
+    const lookups = await lookupsDuring(store, async () => {
+      await phone.get("/repos/alice/forge");
+      await phone.get("/repos/alice/forge");
+    });
+    expect(lookups).toBe(1);
+  });
+
+  it("keeps a separate entry for each repository", async () => {
+    const { h, store, alice, bob } = await forge();
+    await h.createRepo(alice, "anvil", "private");
+    await h.addCollaborator(alice, "anvil", "bob", "read");
+    const lookups = await lookupsDuring(store, async () => {
+      await bob.get("/repos/alice/forge");
+      await bob.get("/repos/alice/anvil");
+      await bob.get("/repos/alice/forge");
+      await bob.get("/repos/alice/anvil");
+    });
+    expect(lookups).toBe(2);
+  });
+
+  it("never lends one session's entry to another user", async () => {
+    const { h, store, bob } = await forge();
+    await bob.get("/repos/alice/forge");
+    const carol = await h.user("carol");
+    let status = 0;
+    const lookups = await lookupsDuring(store, async () => {
+      status = (await carol.get("/repos/alice/forge")).status;
+    });
+    expect(status).toBe(404);
+    expect(lookups).toBe(1);
+  });
+
+  it("looks again when the cached role falls short, so a promotion applies at once", async () => {
+    const { alice, bob } = await forge();
+    expect((await bob.get("/repos/alice/forge")).status).toBe(200);
+    await problem(await bob.delete("/repos/alice/forge"), 403);
+    expect((await alice.patch("/repos/alice/forge/collaborators/bob", { role: "admin" })).status).toBe(200);
+    expect((await bob.delete("/repos/alice/forge")).status).toBe(204);
+  });
+
+  it("does no collaborator lookup for the owner or for anonymous callers", async () => {
+    const { h, store, alice } = await forge();
+    const lookups = await lookupsDuring(store, async () => {
+      await alice.get("/repos/alice/forge");
+      await alice.put("/repos/alice/forge/labels/bug", {});
+      await h.anonymous.get("/repos/alice/forge");
+    });
+    expect(lookups).toBe(0);
+  });
+});
