@@ -0,0 +1,33 @@
+import type { CollaboratorRole } from "../domain/roles.ts";
+import type { Store } from "../store/types.ts";
+
+const ENTRY_LIFETIME_MS = 60_000;
+
+export class RoleCache {
+  readonly #entries = new Map<string, { role: CollaboratorRole; expiresAt: number }>();
+
+  get(userId: string, repoId: string, now: number): CollaboratorRole | undefined {
+    const entry = this.#entries.get(key(userId, repoId));
+    if (entry === undefined || entry.expiresAt <= now) return undefined;
+    return entry.role;
+  }
+
+  set(userId: string, repoId: string, role: CollaboratorRole, now: number): void {
+    this.#entries.set(key(userId, repoId), { role, expiresAt: now + ENTRY_LIFETIME_MS });
+  }
+}
+
+const caches = new WeakMap<Store, RoleCache>();
+
+export function roleCacheFor(store: Store): RoleCache {
+  let cache = caches.get(store);
+  if (cache === undefined) {
+    cache = new RoleCache();
+    caches.set(store, cache);
+  }
+  return cache;
+}
+
+function key(userId: string, repoId: string): string {
+  return `${userId}:${repoId}`;
+}
