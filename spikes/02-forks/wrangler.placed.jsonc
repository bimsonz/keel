// Same code, Worker placed in a fixed cloud region near the Artifacts backend.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "keel-spike-02-forker-placed",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": { "enabled": true },
  "placement": { "mode": "targeted", "region": "aws:us-west-2" },
  "artifacts": [{ "binding": "ARTIFACTS", "namespace": "keel-spike-02" }]
}
