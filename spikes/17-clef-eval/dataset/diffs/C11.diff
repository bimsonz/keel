+import zlib
+
 from outbox import db
 from outbox.bus import publish

+PARTITIONS = 16
+

-def relay(batch_size: int = 100) -> None:
-    rows = db.fetch_unsent(limit=batch_size)  # ORDER BY id
-    for row in rows:
-        publish(row.topic, row.payload)
-        db.mark_sent(row.id)
+def partition_of(aggregate_id: str) -> int:
+    return zlib.crc32(aggregate_id.encode()) % PARTITIONS
+
+
+def relay_partition(partition: int, batch_size: int = 100) -> None:
+    # One worker per partition; all rows of an aggregate share a partition.
+    rows = db.fetch_unsent(partition=partition, limit=batch_size)  # ORDER BY id
+    for row in rows:
+        publish(row.topic, row.payload, key=row.aggregate_id)
+        db.mark_sent(row.id)
