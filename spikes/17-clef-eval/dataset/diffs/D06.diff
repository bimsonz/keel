--- /dev/null
+++ b/src/ui/preferences.ts
@@ -0,0 +1 @@
+import type { Db } from "../db";
+
+export interface UiPreferences {
+  theme: "light" | "dark" | "system";
+  density: "comfortable" | "compact";
+}
+
+// Theme and density rarely change; keep them for the whole session.
+const sessionPrefs = new Map<string, UiPreferences>();
+
+export async function preferencesFor(db: Db, sessionId: string, userId: string): Promise<UiPreferences> {
+  let prefs = sessionPrefs.get(sessionId);
+  if (prefs === undefined) {
+    prefs = await db.preferences.find(userId);
+    sessionPrefs.set(sessionId, prefs);
+  }
+  return prefs;
+}
