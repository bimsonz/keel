# expect-red: pnpm exec vitest run --project unit packages/runner-protocol/test/deps-sh.test.ts
# kills: deps.keep.paths
# why: A backslash in a path is read as an escape, so the file moved is the one named without it
diff --git a/packages/runner-protocol/src/deps.ts b/packages/runner-protocol/src/deps.ts
index bb60317b..8097d665 100644
--- a/packages/runner-protocol/src/deps.ts
+++ b/packages/runner-protocol/src/deps.ts
@@ -219,7 +219,7 @@ export const DEPS_KEEP_SH = [
   `  LC_ALL=C sed 's/  /  .\\//' "$i.lines" >"$i.sums" 2>/dev/null || { echo install-mismatch; return 1; }`,
   '  sha256sum --quiet --strict -c "$i.sums" >/dev/null 2>&1 || { echo install-mismatch; return 1; }',
   '  rm -rf "$o" 2>/dev/null; mkdir -p "$o" 2>/dev/null || { echo keep-failed; return 1; }',
-  "  while IFS= read -r line; do",
+  "  while IFS= read line; do",
   "    p=${line#*  }",
   '    case $p in */*) mkdir -p "$o/${p%/*}" 2>/dev/null || { echo keep-failed; return 1; } ;; esac',
   '    mv -- "$p" "$o/$p" 2>/dev/null || { echo keep-failed; return 1; }',
