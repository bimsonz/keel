# kills: bundle.rehydrate-verified
# why: The refetch skips its sha256 check, so any whole bundle served at the address replaces the workspace
diff --git a/packages/runner-protocol/src/bundle.ts b/packages/runner-protocol/src/bundle.ts
index 1d9d8f2..d6fa2c4 100644
--- a/packages/runner-protocol/src/bundle.ts
