+++ b/packages/gitcore/src/push.ts
@@ -136,8 +136,7 @@ export function outcomeOf(updates: readonly RefUpdate[], report: Report): PushOu
       status: 200,
       message: `server refused the push: ${report.errors.join("; ")}`,
     };
