# expect-red: pnpm exec vitest run --project unit packages/runner-protocol/test/deps-sh.test.ts
# kills: deps.keep.empty
# why: A list of no lines is handed on to the checksum tool: BSD's passes it, so nothing is kept and the keep answers 0 (GNU's refuses an empty list itself, so this one survives on Linux)
diff --git a/packages/runner-protocol/src/deps.ts b/packages/runner-protocol/src/deps.ts
index bb60317b..65b0360a 100644
--- a/packages/runner-protocol/src/deps.ts
+++ b/packages/runner-protocol/src/deps.ts
@@ -213,7 +213,7 @@ export const DEPS_KEEP_SH = [
   "  i=$1; o=$3",
   '  [ -f "$i" ] && [ "$(sha256sum "$i" 2>/dev/null | cut -c1-64)" = "$2" ] || { echo install-mismatch; return 1; }',
   '  [ "$(head -n 1 "$i")" = keel.install/1 ] || { echo install-mismatch; return 1; }',
-  `  tail -n +2 "$i" >"$i.lines"; [ "$(tail -c 1 "$i.lines" | wc -l | tr -d ' ')" = 1 ] || { echo install-mismatch; return 1; }`,
+  `  tail -n +2 "$i" >"$i.lines"; [ ! -s "$i.lines" ] || [ "$(tail -c 1 "$i.lines" | wc -l | tr -d ' ')" = 1 ] || { echo install-mismatch; return 1; }`,
   `  LC_ALL=C grep -qvE '^[0-9a-f]{64}  [^/]' "$i.lines" 2>/dev/null; [ $? -eq 1 ] || { echo install-mismatch; return 1; }`,
   `  LC_ALL=C grep -qE '^[0-9a-f]{64}  (.*/)?\\.\\.(/|$)' "$i.lines" 2>/dev/null; [ $? -eq 1 ] || { echo install-mismatch; return 1; }`,
   `  LC_ALL=C sed 's/  /  .\\//' "$i.lines" >"$i.sums" 2>/dev/null || { echo install-mismatch; return 1; }`,
