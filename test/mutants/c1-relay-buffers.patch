# expect-red: pnpm vitest run --project unit packages/gitcore/test/fetch.test.ts -t "relay.cap-streamed"
# kills: relay.cap-streamed
# why: The whole answer is buffered before the cap is checked, so a pack over the cap exhausts the Worker before PackTooLarge
diff --git a/packages/gitcore/src/fetch.ts b/packages/gitcore/src/fetch.ts
index d14b992..b27af91 100644
--- a/packages/gitcore/src/fetch.ts
+++ b/packages/gitcore/src/fetch.ts
@@ -62,7 +62,7 @@ async function requestPack(
     await res.body?.cancel();
     throw new Error(`upload-pack answered HTTP ${res.status}`);
   }
-  const reader = res.body?.getReader();
+  const reader = new Response(new Uint8Array(await res.arrayBuffer())).body?.getReader();
   if (reader === undefined) throw new Error("upload-pack answered without a body");
   return reader;
 }
