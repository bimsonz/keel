# expect-red: pnpm exec vitest run --project unit packages/runner-protocol/test/deps-sh.test.ts packages/runner-protocol/test/deps-build.test.ts
# kills: deps.keep.dash, deps.build.dash
# why: A listed path that starts with a dash is an option of mv: GNU's answers --help with exit 0 and moves nothing, and any other is keep-failed on every build
diff --git a/packages/runner-protocol/src/deps.ts b/packages/runner-protocol/src/deps.ts
index bb60317b..fa34a89a 100644
--- a/packages/runner-protocol/src/deps.ts
+++ b/packages/runner-protocol/src/deps.ts
@@ -222,7 +222,7 @@ export const DEPS_KEEP_SH = [
   "  while IFS= read -r line; do",
   "    p=${line#*  }",
   '    case $p in */*) mkdir -p "$o/${p%/*}" 2>/dev/null || { echo keep-failed; return 1; } ;; esac',
-  '    mv -- "$p" "$o/$p" 2>/dev/null || { echo keep-failed; return 1; }',
+  '    mv "$p" "$o/$p" 2>/dev/null || { echo keep-failed; return 1; }',
   '  done <"$i.lines"',
   "}",
 ].join("\n");
