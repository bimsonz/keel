# why: a skipped test counts as passed, so a change that skips tests passes as many as trunk and the shrink rule never sees the drop
diff --git a/packages/core/src/application/verification/junit.ts b/packages/core/src/application/verification/junit.ts
index 01b65148..5564d1ed 100644
--- a/packages/core/src/application/verification/junit.ts
+++ b/packages/core/src/application/verification/junit.ts
@@ -113,5 +113,5 @@ export const testCountsOf = (xml: string): JunitCounts | undefined => {
   if (cases === undefined) return undefined;
   const failed = cases.filter((c) => c.failed).length;
   const skipped = cases.filter((c) => !c.failed && c.skipped).length;
-  return { total: cases.length, passed: cases.length - failed - skipped, failed, skipped };
+  return { total: cases.length, passed: cases.length - failed, failed, skipped };
 };
