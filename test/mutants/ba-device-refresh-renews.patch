@@ -485,6 +485,12 @@ export function authOptions(config: AuthConfig) {
             };
           },
         },
+        update: {
+          before: async (session, context) => {
+            const held: unknown = context?.context.session?.session["passkeyAt"];
+            return { data: typeof held === "number" ? { ...session, passkeyAt: Date.now() } : session };
+          },
+        },
       },
       // keel.town's privacy notice promises GitHub's token is never kept: Keel reads
